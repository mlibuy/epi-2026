# Prestaciones por rol (SIN P1 - todos la tienen)
output$plot_kines_prest_rol <- renderPlotly({
df <- DATOS_KINES$prestaciones$por_rol
if (is.list(df) && !is.data.frame(df)) {
df <- bind_rows(df)
}
# Solo P2-P6 (excluir P1 que todos tienen al 100%)
df_long <- df %>%
select(rol, P2_pct, P3_pct, P4_pct, P5_pct, P6_pct) %>%
pivot_longer(cols = -rol, names_to = "prestacion", values_to = "pct") %>%
mutate(
prest_nombre = case_when(
prestacion == "P2_pct" ~ "P2-Ejercicios Resp",
prestacion == "P3_pct" ~ "P3-Aspiración",
prestacion == "P4_pct" ~ "P4-Motora",
prestacion == "P5_pct" ~ "P5-Aerosol",
prestacion == "P6_pct" ~ "P6-Vía Aérea"
)
)
plot_ly(
data = df_long,
x = ~prest_nombre,
y = ~pct,
color = ~rol,
type = "bar",
colors = c("#3498db", "#e74c3c")
) %>%
layout(
barmode = "group",
title = "Prestaciones P2-P6 (sin P1-Evaluación)",
xaxis = list(title = ""),
yaxis = list(title = "% Atenciones"),
margin = list(b = 120)
)
})
