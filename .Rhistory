}
# Asegurarse de que hay datos
if (nrow(df) == 0 || is.null(df)) {
return(plot_ly() %>% layout(title = "No hay datos de patologías disponibles"))
}
# Tomar top 10
df <- df %>%
arrange(desc(total)) %>%
head(10)
plot_ly(
