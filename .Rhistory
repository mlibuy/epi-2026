# ── Gráfico: Turnos Día vs Noche por profesional (barras apiladas) ───────────
output$plot_kines_turnos_dia_noche <- renderPlotly({
df <- kines_turnos_filtrado() %>%
arrange(desc(n_turnos_total))
plot_ly(data = df) %>%
add_trace(
y = ~profesional, x = ~n_turnos_dia,
name = "Día",   type = "bar", orientation = "h",
marker = list(color = "#f39c12")
) %>%
add_trace(
y = ~profesional, x = ~n_turnos_noche,
name = "Noche", type = "bar", orientation = "h",
marker = list(color = "#2c3e50")
) %>%
layout(
barmode = "stack",
xaxis = list(title = "N° Turnos"),
yaxis = list(title = "", categoryorder = "total ascending"),
legend = list(x = 0.7, y = 0.1),
margin = list(l = 160)
)
})
# ── Gráfico: Evolución mensual global ───────────────────────────────────────
output$plot_kines_turnos_evolucion <- renderPlotly({
df <- DATOS_KINES$turnos_kines$resumen_mes_global
if (is.list(df) && !is.data.frame(df)) df <- bind_rows(df)
# Filtrar por año si no es "todos"
anio_sel <- as.integer(input$kines_turno_filtro_anio)
df <- df %>% filter(año == anio_sel)
plot_ly(data = df) %>%
add_trace(
x = ~año_mes, y = ~n_turnos_total,
name = "Turnos Totales", type = "scatter", mode = "lines+markers",
line = list(color = "#2980b9", width = 3),
marker = list(size = 8)
) %>%
add_trace(
x = ~año_mes, y = ~n_turnos_dia,
name = "Día", type = "scatter", mode = "lines+markers",
line = list(color = "#f39c12", width = 2, dash = "dot"),
marker = list(size = 6)
) %>%
add_trace(
x = ~año_mes, y = ~n_turnos_noche,
name = "Noche", type = "scatter", mode = "lines+markers",
line = list(color = "#2c3e50", width = 2, dash = "dot"),
marker = list(size = 6)
) %>%
layout(
xaxis = list(title = "Mes", tickangle = -45),
yaxis = list(title = "N° Turnos"),
hovermode = "x unified"
)
})
# ── Gráfico: Evolución mensual por profesional ───────────────────────────────
output$plot_kines_turnos_prof_mes <- renderPlotly({
req(input$kines_turno_prof_evol)
df <- DATOS_KINES$turnos_kines$por_mes
if (is.list(df) && !is.data.frame(df)) df <- bind_rows(df)
anio_sel <- as.integer(input$kines_turno_filtro_anio)
df_prof <- df %>%
filter(profesional == input$kines_turno_prof_evol,
año == anio_sel)
plot_ly(data = df_prof) %>%
add_trace(
x = ~año_mes, y = ~n_turnos,
name = "Turnos", type = "bar",
marker = list(color = "#2980b9"),
yaxis = "y"
) %>%
add_trace(
x = ~año_mes, y = ~atenciones_prom_turno,
name = "Atenc. Prom/Turno", type = "scatter", mode = "lines+markers",
line = list(color = "#e74c3c", width = 3),
marker = list(size = 8),
yaxis = "y2"
) %>%
layout(
xaxis  = list(title = "Mes", tickangle = -45),
yaxis  = list(title = "N° Turnos"),
yaxis2 = list(title = "Atenc. Prom/Turno", overlaying = "y", side = "right"),
legend = list(x = 0.1, y = 1),
hovermode = "x unified"
)
})
