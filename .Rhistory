)
})
# ========================================================================
# RENDIMIENTO POR TURNO - KINESIOLOGÍA
# ========================================================================
# Reactivo: filtrar datos de turnos según selección del usuario
kines_turnos_filtrado <- reactive({
df <- DATOS_KINES$turnos_kines$resumen_profesional
if (is.list(df) && !is.data.frame(df)) df <- bind_rows(df)
# Filtrar por año/mes usando los datos por_mes
df_mes <- DATOS_KINES$turnos_kines$por_mes
if (is.list(df_mes) && !is.data.frame(df_mes)) df_mes <- bind_rows(df_mes)
if (input$kines_turno_filtro_tipo == "mes") {
anio_sel <- as.integer(input$kines_turno_filtro_anio)
mes_sel  <- as.integer(input$kines_turno_filtro_mes)
df_mes_fil <- df_mes %>%
filter(año == anio_sel, mes == mes_sel)
# Recalcular resumen por profesional para ese mes
df <- df_mes_fil %>%
group_by(profesional, rol) %>%
summarise(
n_turnos_total          = sum(n_turnos),
n_turnos_dia            = sum(n_turnos_dia),
n_turnos_noche          = sum(n_turnos_noche),
atenciones_totales      = sum(atenciones_totales),
atenciones_prom_turno   = round(sum(atenciones_totales) / sum(n_turnos), 1),
prestaciones_totales    = sum(prestaciones_totales),
prest_prom_turno        = round(sum(prestaciones_totales) / sum(n_turnos), 1),
prest_por_atencion      = round(sum(prestaciones_totales) / sum(atenciones_totales), 2),
.groups = "drop"
) %>%
arrange(desc(n_turnos_total))
} else {
# Año completo: filtrar por año en por_mes y recalcular
anio_sel <- as.integer(input$kines_turno_filtro_anio)
df_anio  <- df_mes %>% filter(año == anio_sel)
if (nrow(df_anio) > 0) {
df <- df_anio %>%
group_by(profesional, rol) %>%
summarise(
n_turnos_total          = sum(n_turnos),
n_turnos_dia            = sum(n_turnos_dia),
n_turnos_noche          = sum(n_turnos_noche),
atenciones_totales      = sum(atenciones_totales),
atenciones_prom_turno   = round(sum(atenciones_totales) / sum(n_turnos), 1),
prestaciones_totales    = sum(prestaciones_totales),
prest_prom_turno        = round(sum(prestaciones_totales) / sum(n_turnos), 1),
prest_por_atencion      = round(sum(prestaciones_totales) / sum(atenciones_totales), 2),
.groups = "drop"
) %>%
arrange(desc(n_turnos_total))
}
}
# Filtrar tipo de turno si se seleccionó
if (input$kines_turno_tipo_turno == "Día") {
df <- df %>%
mutate(n_turnos_total = n_turnos_dia,
n_turnos_noche = 0)
} else if (input$kines_turno_tipo_turno == "Noche") {
df <- df %>%
mutate(n_turnos_total = n_turnos_noche,
n_turnos_dia   = 0)
}
df
})
# Actualizar selector de profesional para evolución mensual
observe({
df <- DATOS_KINES$turnos_kines$resumen_profesional
if (is.list(df) && !is.data.frame(df)) df <- bind_rows(df)
profs <- df %>% arrange(desc(n_turnos_total)) %>% pull(profesional)
updateSelectInput(session, "kines_turno_prof_evol",
choices = profs, selected = profs[1])
})
# ── Value Boxes ─────────────────────────────────────────────────────────────
output$kines_vbox_n_turnos <- renderValueBox({
df <- kines_turnos_filtrado()
valueBox(
format(sum(df$n_turnos_total, na.rm = TRUE), big.mark = ","),
"Turnos Totales",
icon = icon("calendar-check"),
color = "blue"
)
})
output$kines_vbox_prom_atenc <- renderValueBox({
df <- kines_turnos_filtrado()
prom <- if (sum(df$n_turnos_total) > 0)
round(sum(df$atenciones_totales) / sum(df$n_turnos_total), 1) else 0
valueBox(
prom,
"Atenciones Promedio / Turno",
icon = icon("user-injured"),
color = "green"
)
})
output$kines_vbox_prom_prest <- renderValueBox({
df <- kines_turnos_filtrado()
prom <- if (sum(df$n_turnos_total) > 0)
round(sum(df$prestaciones_totales) / sum(df$n_turnos_total), 1) else 0
valueBox(
prom,
"Prestaciones Promedio / Turno",
icon = icon("clipboard-list"),
color = "yellow"
)
})
output$kines_vbox_prom_sesion <- renderValueBox({
df <- kines_turnos_filtrado()
prom <- if (sum(df$n_turnos_total, na.rm = TRUE) > 0 && "prest_por_atencion" %in% names(df))
round(mean(df$prest_por_atencion, na.rm = TRUE), 2) else "—"
valueBox(
prom,
"Prest. Promedio / Atención",
icon = icon("clipboard-check"),
color = "red"
)
})
# ── Tabla resumen por profesional ────────────────────────────────────────────
output$table_kines_turnos_resumen <- renderDT({
df <- kines_turnos_filtrado()
df_tabla <- df %>%
select(profesional, rol, n_turnos_total, n_turnos_dia, n_turnos_noche,
atenciones_totales, atenciones_prom_turno,
prestaciones_totales, prest_prom_turno, prest_por_atencion) %>%
mutate(
atenciones_totales   = format(atenciones_totales, big.mark = ","),
prestaciones_totales = format(prestaciones_totales, big.mark = ",")
)
datatable(
df_tabla,
colnames = c("Profesional", "Rol", "Turnos Totales",
"Turnos Día", "Turnos Noche",
"Atenc. Totales", "Atenc. Prom/Turno",
"Prest. Totales", "Prest. Prom/Turno", "Prest. / Atención"),
options = list(
pageLength = 20,
dom        = 'ft',
ordering   = TRUE,
language   = list(search = "Buscar:")
),
rownames = FALSE
) %>%
formatStyle(
"atenciones_prom_turno",
background = styleColorBar(range(df$atenciones_prom_turno, na.rm = TRUE), "#a8d8ea"),
backgroundSize   = "95% 70%",
backgroundRepeat = "no-repeat",
backgroundPosition = "center"
) %>%
formatStyle(
"prest_prom_turno",
background = styleColorBar(range(df$prest_prom_turno, na.rm = TRUE), "#f9c784"),
backgroundSize   = "95% 70%",
backgroundRepeat = "no-repeat",
backgroundPosition = "center"
) %>%
formatStyle(
"prest_por_atencion",
background = styleColorBar(range(df$prest_por_atencion, na.rm = TRUE), "#b8e0b8"),
backgroundSize   = "95% 70%",
backgroundRepeat = "no-repeat",
backgroundPosition = "center"
)
})
